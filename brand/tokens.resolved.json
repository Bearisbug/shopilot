    },
    "opacity": {
      "$type": "number",
      "$extensions": {
        "com.design-extract": {
          "scaling": "ratio",
          "scope": "invariant",
          "confidence": "inferred",
          "provenance": "convention: specimen spec §2 reference state-layer values; pressed raised to 0.18: hover 0.08 vs pressed separation on the mango primary button reaches deltaE00 >= 3"
        }
      },
      "hover": {
