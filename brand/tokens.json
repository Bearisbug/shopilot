{
  "$schema": "./tokens-schema.md",
  "$comment": "Shopilot 产品界面 tokens（profile-2，最小深度 + 图表配色，仅浅色模式）。品牌值来自 Quilt 设计系统 v5 快照 brand/upstream/quilt-ds-v5。",
  "meta": {
    "app": "Shopilot",
    "source": "visual-system",
    "spec": "DTCG-1.0 + design-extract/profile-2",
    "tiers": ["primitive", "semantic", "component"],
    "extensions": "com.design-extract",
    "modes": ["light"],
    "defaultMode": "light",
    "modeModel": "light-only",
    "themes": [],
    "medium": "desktop",
    "platform": "web",
    "units": { "base": 4, "spaceUnit": 4, "sizeBasis": 1, "remBase": 16, "timeUnit": "ms", "reference": "1 unit = 1 CSS px at 1x" },
    "defaults": { "scope": "derived", "scaling": "absolute", "confidence": "measured" },
    "languages": ["zh-CN", "en", "ms", "th", "vi"],
    "roles": {
      "text.primary": "semantic.color.text.primary",
      "text.secondary": "semantic.color.text.secondary",
      "text.tertiary": "semantic.color.text.tertiary",
      "surface.sunken": "semantic.color.surface.sunken",
      "surface.default": "semantic.color.surface.background",
      "surface.raised": "semantic.color.surface.raised",
      "surface.overlay": "semantic.color.surface.overlay",
      "accent": "semantic.color.action.primary",
      "onAccent": "semantic.color.text.onAction",
      "selection": "semantic.color.surface.selected",
      "divider": "semantic.color.border.subtle",
      "feedback.success": "semantic.color.feedback.success",
      "feedback.warning": "semantic.color.feedback.warning",
      "feedback.error": "semantic.color.feedback.error",
      "elevation.sunken": { "status": "notApplicable", "reason": "设计系统 v5 禁止投影：内嵌区只靠 surface-variant 填充区分" },
      "elevation.default": { "status": "notApplicable", "reason": "页面底不投影" },
      "elevation.raised": { "status": "notApplicable", "reason": "设计系统 v5 禁止投影：面板靠白底与奶油底的明度差和发丝线区分" },
      "elevation.overlay": { "status": "notApplicable", "reason": "设计系统 v5 禁止投影：对话框与抽屉靠遮罩与白底区分" },
      "state.hover": "semantic.state.hover.opacity",
      "state.focus": "semantic.state.focus.opacity",
      "state.pressed": "semantic.state.pressed.opacity",
      "state.dragged": "semantic.state.dragged.opacity",
      "state.disabled": "semantic.state.disabled.opacity",
      "focusRing.width": "semantic.state.focus.ringWidth",
      "focusRing.offset": "semantic.state.focus.ringOffset",
      "focusRing.color": "semantic.state.focus.ring",
      "space.withinGroup": "semantic.space.withinGroup",
      "space.betweenGroups": "semantic.space.betweenGroups",
      "space.section": "semantic.space.section",
      "radius.pill": "semantic.radius.pill",
      "radius.innerMin": "semantic.radius.innerMin",
      "hairline": "semantic.layout.hairline"
    },
    "notUsed": [
      { "id": "gradient", "note": "设计系统 v5：产品界面无渐变；官网 /、/en 的光晕例外，只经 semantic.site（2026-10-22 用户定）", "css": { "valuePattern": "gradient\\(" } },
      { "id": "shadow", "note": "设计系统 v5：产品界面无投影，面板靠底色与发丝线分层；官网 /、/en 例外，只用 semantic.site.shadow（2026-10-22 用户定）", "css": { "property": "box-shadow" } },
      { "id": "text-shadow", "note": "无文字阴影与发光", "css": { "property": "text-shadow" } },
      { "id": "backdrop-filter", "note": "产品界面无玻璃效果；官网 /、/en 顶栏与插图面板例外，只用 semantic.site 的玻璃色与模糊（2026-10-22 用户定）", "css": { "property": "backdrop-filter" } },
      { "id": "mango-as-text", "note": "芒果色在白底只有 1.93:1，只做填充，不做文字、链接、图标或细线；链接用焦糖 text.link" },
      { "id": "nested-cards", "note": "卡片不套卡片" }
    ]
  },
  "primitive": {
    "color": {
      "$type": "color",
      "cocoa": {
        "900": { "$value": "#2F1F16", "$description": "可可：正文、mango 上的文字、深色强调块" },
        "600": { "$value": "#6B5B51", "$description": "次级文字" },
        "400": { "$value": "#9A887B", "$description": "控件边框" }
      },
      "cream": {
        "0": { "$value": "#FFFFFF" },
        "50": { "$value": "#FFF8F1", "$description": "奶油页面底" },
        "100": { "$value": "#F7EEE6", "$description": "内嵌区、表头、买家气泡" },
        "150": { "$value": "#F5EBE2", "$description": "中性 Chip、标签底" },
        "200": { "$value": "#F0E2D4", "$description": "发丝线" }
      },
      "brand": {
        "mango": { "$value": "#FFA748", "$description": "芒果：只做填充" },
        "mangoLight": { "$value": "#FFC98F", "$description": "浅芒果：标志叠层与插画" },
        "mangoTint": { "$value": "#FFECD8", "$description": "当前导航底、选中行底、我方气泡" },
        "warmTint": { "$value": "#FFF3E6", "$description": "AI 草稿区、提示块" },
        "caramel": { "$value": "#8A4F00", "$description": "焦糖：链接、当前导航文字、选中指示、焦点环" }
      },
      "site": {
        "glass": { "$value": "#FFF8F1B8", "$description": "官网玻璃面：奶油底 72% 不透明" },
        "glassEdge": { "$value": "#FFFFFFB3", "$description": "官网玻璃边缘高光：白 70%" },
        "glowMango": { "$value": "#FFA74866", "$description": "官网光晕：芒果 40%" },
        "glowCaramel": { "$value": "#8A4F0024", "$description": "官网光晕：焦糖 14%" },
        "amber": { "$value": "#C47A24", "$description": "官网光晕与标题渐变的中间色：焦糖与芒果各半，在奶油底上 3.2:1，只用于 32px 以上的粗体字" },
        "shadow": { "$value": "#2F1F1629", "$description": "官网投影色：可可 16%" }
      },
      "feedback": {
        "success": { "$value": "#17704A" },
        "warning": { "$value": "#7A5E00" },
        "error": { "$value": "#B42318" }
      },
      "dataViz": {
        "series": {
          "1": { "$value": "#BC6A78" },
          "2": { "$value": "#3A86F3" },
          "3": { "$value": "#754A82" },
          "4": { "$value": "#323FE1" },
          "5": { "$value": "#F71E61" },
          "6": { "$value": "#8836E1" }
        }
      }
    },
    "dimension": {
      "$type": "dimension",
      "space": {
        "$extensions": { "com.design-extract": { "scaling": "scalable" } },
        "1": { "$value": 4 }, "2": { "$value": 8 }, "3": { "$value": 12 }, "4": { "$value": 16 },
        "5": { "$value": 20 }, "6": { "$value": 24 }, "8": { "$value": 32 }, "10": { "$value": 40 },
        "12": { "$value": 48 }, "16": { "$value": 64 },
        "24": { "$value": 96, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "官网区块上下留白（2026-10-22 补）：桌面端区块间距取 4 的倍数 96，是产品界面最大间距 64 的 1.5 倍" }
      },
      "radius": {
        "xs": { "$value": 4 }, "sm": { "$value": 6 }, "md": { "$value": 12 }, "lg": { "$value": 20 }, "pill": { "$value": 9999 },
        "xl": { "$value": 28, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "官网功能格圆角（2026-10-22 补）" }
      },
      "fontSize": {
        "$extensions": { "com.design-extract": { "scaling": "scalable" } },
        "12": { "$value": 12 }, "14": { "$value": 14 }, "18": { "$value": 18 }, "24": { "$value": 24 }, "30": { "$value": 30 },
        "32": { "$value": 32, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "官网窄屏大标题与区块标题（2026-10-22 补）" },
        "48": { "$value": 48, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "官网中屏区块标题与大段陈述（2026-10-22 补）" },
        "64": { "$value": 64, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "官网宽屏区块标题与收尾标题（2026-10-22 补）" },
        "96": { "$value": 96, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "官网宽屏首屏大标题（2026-10-22 补）" }
      },
      "tracking": {
        "tight": { "$value": -0.3 }, "none": { "$value": 0 },
        "hero": { "$value": -2.4, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "96px 大标题收紧 0.025em（2026-10-22 补）" },
        "section": { "$value": -1.6, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "64px 标题收紧 0.025em（2026-10-22 补）" },
        "headline": { "$value": -1.0, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "48px 标题收紧约 0.02em（2026-10-22 补）" },
        "title": { "$value": -0.5, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "32px 标题收紧约 0.016em（2026-10-22 补）" }
      },
      "hairline": { "$value": 1 },
      "ring": { "width": { "$value": 2 }, "offset": { "$value": 2 } }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Nunito", "IBM Plex Sans Thai Looped", "PingFang SC", "Microsoft YaHei", "system-ui", "sans-serif"] },
      "cjk": { "$value": ["PingFang SC", "Microsoft YaHei", "Nunito", "system-ui", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] },
      "display": { "$value": ["-apple-system", "BlinkMacSystemFont", "PingFang SC", "Segoe UI", "Helvetica Neue", "Microsoft YaHei", "system-ui", "sans-serif"], "$description": "官网字体（2026-10-22 用户定）：系统无衬线，苹果设备上是 SF Pro 与苹方；产品界面仍用 sans" }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 },
      "bold": { "$value": 700, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "官网标题（2026-10-22 补）" }
    },
    "ratio": {
      "$type": "number",
      "$extensions": { "com.design-extract": { "scaling": "ratio" } },
      "lineHeight": {
        "tight": { "$value": 1.25 }, "snug": { "$value": 1.4 }, "normal": { "$value": 1.6 },
        "display": { "$value": 1.08, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "96px 大标题行高（2026-10-22 补）" },
        "heading": { "$value": 1.12, "$extensions": { "com.design-extract": { "confidence": "derived" } }, "$description": "48–64px 标题行高（2026-10-22 补）" }
      }
    },
    "duration": { "$type": "duration", "fast": { "$value": 120 }, "base": { "$value": 200 }, "slow": { "$value": 320 } },
    "easing": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] }, "exit": { "$value": [0.4, 0, 1, 1] } },
    "opacity": {
      "$type": "number",
      "$extensions": { "com.design-extract": { "scaling": "ratio", "scope": "invariant", "confidence": "inferred", "provenance": "convention: specimen spec §2 reference state-layer values; pressed raised to 0.18: hover 0.08 vs pressed separation on the mango primary button reaches deltaE00 >= 3" } },
      "hover": { "$value": 0.08 }, "focus": { "$value": 0.1 }, "pressed": { "$value": 0.18 }, "dragged": { "$value": 0.16 }, "disabled": { "$value": 0.38 }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "text": {
        "primary": { "$value": "{primitive.color.cocoa.900}" },
        "secondary": { "$value": "{primitive.color.cocoa.600}" },
        "tertiary": { "$value": "{primitive.color.cocoa.600}", "$description": "设计系统 v5 只有一档次级文字；弱文字与次级文字同值以保住 4.5:1" },
        "onAction": { "$value": "{primitive.color.cocoa.900}" },
        "link": { "$value": "{primitive.color.brand.caramel}" },
        "onInverse": { "$value": "{primitive.color.cream.50}" }
      },
      "surface": {
        "sunken": { "$value": "{primitive.color.cream.100}" },
        "background": { "$value": "{primitive.color.cream.50}" },
        "raised": { "$value": "{primitive.color.cream.0}" },
        "overlay": { "$value": "{primitive.color.cream.0}" },
        "selected": { "$value": "{primitive.color.brand.mangoTint}" },
        "neutral": { "$value": "{primitive.color.cream.150}" },
        "warm": { "$value": "{primitive.color.brand.warmTint}" },
        "inverse": { "$value": "{primitive.color.cocoa.900}" },
        "decorative": { "$value": "{primitive.color.brand.mangoLight}" }
      },
      "border": {
        "subtle": { "$value": "{primitive.color.cream.200}" },
        "control": { "$value": "{primitive.color.cocoa.400}" }
      },
      "action": {
        "primary": { "$value": "{primitive.color.brand.mango}" },
        "secondary": { "$value": "{primitive.color.cream.150}" }
      },
      "feedback": {
        "success": { "$value": "{primitive.color.feedback.success}" },
        "warning": { "$value": "{primitive.color.feedback.warning}" },
        "error": { "$value": "{primitive.color.feedback.error}" }
      },
      "dataViz": {
        "$description": "Derived (light mode only). Exclusion: with the four surfaces (#F7EEE6, #FFF8F1, #FFFFFF x2) requiring >= 3:1, every OKLCH hue from about 15 to 150 deg comes within dE 15 of a feedback color (error H 29.5, warning H 88.3, success H 159.6, all at L about 0.49), so the accent hue (mango H 64.4, L 0.799 above the 0.43-0.77 band) has no in-band variant. series.1 is the nearest feasible hue to the accent: H 9.7 L 0.620 C 0.105 (#BC6A78). Others chosen by random search over a pool of H step 6, L 0.45-0.66, C 0.10-0.24 that pass band, chroma, 3:1 and feedback >= 15, maximizing the worst adjacent CVD dE: 2 #3A86F3 (H 258.0 L 0.629 C 0.180), 3 #754A82 (H 318.1 L 0.480 C 0.100), 4 #323FE1 (H 270.0 L 0.480 C 0.239), 5 #F71E61 (H 12.2 L 0.631 C 0.240), 6 #8836E1 (H 300.0 L 0.540 C 0.239). Result: worst adjacent CVD dE 15.5, worst adjacent normal-vision dE 18.8, lowest contrast against surfaces 3.11 (series 2), nearest feedback dE 15.0 (series 1). Single-series charts that follow design system v5 ('main series = caramel') use text.link instead of the series palette.",
        "$extensions": { "com.design-extract": { "confidence": "derived" } },
        "series": {
          "1": { "$value": "{primitive.color.dataViz.series.1}" },
          "2": { "$value": "{primitive.color.dataViz.series.2}" },
          "3": { "$value": "{primitive.color.dataViz.series.3}" },
          "4": { "$value": "{primitive.color.dataViz.series.4}" },
          "5": { "$value": "{primitive.color.dataViz.series.5}" },
          "6": { "$value": "{primitive.color.dataViz.series.6}" }
        }
      }
    },
    "space": {
      "$type": "dimension",
      "$extensions": { "com.design-extract": { "scaling": "scalable" } },
      "withinGroup": { "$value": "{primitive.dimension.space.2}" },
      "betweenGroups": { "$value": "{primitive.dimension.space.4}" },
      "section": { "$value": "{primitive.dimension.space.8}" },
      "siteSection": { "$value": "{primitive.dimension.space.24}", "$description": "官网相邻两个区块之间的上下留白（桌面端）；窄屏用 space.16" }
    },
    "radius": {
      "$type": "dimension",
      "$extensions": { "com.design-extract": { "cornerStyle": "soft" } },
      "sm": { "$value": "{primitive.dimension.radius.sm}" },
      "md": { "$value": "{primitive.dimension.radius.md}" },
      "lg": { "$value": "{primitive.dimension.radius.lg}" },
      "pill": { "$value": "{primitive.dimension.radius.pill}" },
      "innerMin": { "$value": "{primitive.dimension.radius.xs}" }
    },
    "typography": {
      "$type": "typography",
      "$extensions": { "com.design-extract": { "scaling": "scalable", "langOverrides": { "zh": { "fontFamily": "{primitive.fontFamily.cjk}", "letterSpacing": "{primitive.dimension.tracking.none}" } } } },
      "caption": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.12}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.ratio.lineHeight.normal}", "letterSpacing": "{primitive.dimension.tracking.none}" } },
      "body": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.14}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.ratio.lineHeight.normal}", "letterSpacing": "{primitive.dimension.tracking.none}" } },
      "label": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.14}", "fontWeight": "{primitive.fontWeight.medium}", "lineHeight": "{primitive.ratio.lineHeight.snug}", "letterSpacing": "{primitive.dimension.tracking.none}" } },
      "bodyStrong": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.14}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.normal}", "letterSpacing": "{primitive.dimension.tracking.none}" } },
      "heading3": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.18}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.snug}", "letterSpacing": "{primitive.dimension.tracking.none}" } },
      "heading2": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.24}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.tight}", "letterSpacing": "{primitive.dimension.tracking.tight}" } },
      "figure": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.30}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.tight}", "letterSpacing": "{primitive.dimension.tracking.tight}" } },
      "code": {
        "$value": { "fontFamily": "{primitive.fontFamily.mono}", "fontSize": "{primitive.dimension.fontSize.12}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.ratio.lineHeight.normal}", "letterSpacing": "{primitive.dimension.tracking.none}" },
        "$extensions": { "com.design-extract": { "langOverrides": { "zh": { "fontFamily": "{primitive.fontFamily.mono}" } } } }
      }
    },
    "typographyDisplay": {
      "$type": "typography",
      "$description": "官网展示字阶（2026-10-22 补，同日按用户要求改为系统无衬线粗体）：只用于官网，产品界面仍用 typography 五档。窄屏逐档降级：hero 96 → 64 → 32，section 64 → 48 → 32。",
      "$extensions": { "com.design-extract": { "scaling": "scalable", "confidence": "derived", "langOverrides": { "zh": { "fontFamily": "{primitive.fontFamily.display}", "letterSpacing": "{primitive.dimension.tracking.none}" } } } },
      "hero": { "$value": { "fontFamily": "{primitive.fontFamily.display}", "fontSize": "{primitive.dimension.fontSize.96}", "fontWeight": "{primitive.fontWeight.bold}", "lineHeight": "{primitive.ratio.lineHeight.display}", "letterSpacing": "{primitive.dimension.tracking.hero}" } },
      "section": { "$value": { "fontFamily": "{primitive.fontFamily.display}", "fontSize": "{primitive.dimension.fontSize.64}", "fontWeight": "{primitive.fontWeight.bold}", "lineHeight": "{primitive.ratio.lineHeight.heading}", "letterSpacing": "{primitive.dimension.tracking.section}" } },
      "headline": { "$value": { "fontFamily": "{primitive.fontFamily.display}", "fontSize": "{primitive.dimension.fontSize.48}", "fontWeight": "{primitive.fontWeight.bold}", "lineHeight": "{primitive.ratio.lineHeight.heading}", "letterSpacing": "{primitive.dimension.tracking.headline}" } },
      "title": { "$value": { "fontFamily": "{primitive.fontFamily.display}", "fontSize": "{primitive.dimension.fontSize.32}", "fontWeight": "{primitive.fontWeight.bold}", "lineHeight": "{primitive.ratio.lineHeight.tight}", "letterSpacing": "{primitive.dimension.tracking.title}" } },
      "lead": { "$value": { "fontFamily": "{primitive.fontFamily.display}", "fontSize": "{primitive.dimension.fontSize.24}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.ratio.lineHeight.snug}", "letterSpacing": "{primitive.dimension.tracking.none}" } },
      "leadSm": { "$value": { "fontFamily": "{primitive.fontFamily.display}", "fontSize": "{primitive.dimension.fontSize.18}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.ratio.lineHeight.normal}", "letterSpacing": "{primitive.dimension.tracking.none}" } }
    },
    "site": {
      "$description": "官网 / 与 /en 专用（2026-10-22 用户定）：玻璃顶栏、流动光晕、轻投影、功能格圆角与动效时长。产品界面不用这一组。",
      "$extensions": { "com.design-extract": { "scope": "inferred", "confidence": "derived" } },
      "color": {
        "$type": "color",
        "glass": { "$value": "{primitive.color.site.glass}" },
        "glassEdge": { "$value": "{primitive.color.site.glassEdge}" },
        "glowMango": { "$value": "{primitive.color.site.glowMango}" },
        "glowCaramel": { "$value": "{primitive.color.site.glowCaramel}" },
        "aura1": { "$value": "{primitive.color.brand.mango}" },
        "aura2": { "$value": "{primitive.color.brand.mangoLight}" },
        "aura3": { "$value": "{primitive.color.site.amber}", "$description": "光晕第三色，也是标题渐变的中间色" }
      },
      "blur": {
        "$type": "dimension",
        "$extensions": { "com.design-extract": { "scaling": "absolute" } },
        "glass": { "$value": 20, "$description": "玻璃面的背景模糊半径" },
        "aura": { "$value": 40, "$description": "插图面板外圈光晕的模糊半径" }
      },
      "shadow": {
        "$type": "shadow",
        "raised": { "$value": { "offsetX": 0, "offsetY": 16, "blur": 40, "spread": -16, "color": "{primitive.color.site.shadow}" }, "$description": "概念插图面板、玻璃顶栏" },
        "floating": { "$value": { "offsetX": 0, "offsetY": 8, "blur": 20, "spread": -8, "color": "{primitive.color.site.shadow}" }, "$description": "插图里浮起的小卡片" }
      },
      "radius": {
        "$type": "dimension",
        "tile": { "$value": "{primitive.dimension.radius.xl}", "$description": "功能格与大插图卡片" }
      },
      "duration": {
        "$type": "duration",
        "loop": { "$value": 9600, "$description": "功能格概念动效一轮的时长" },
        "aura": { "$value": 8000, "$description": "插图面板外圈光晕转一圈的时长" },
        "drift": { "$value": 24000, "$description": "首屏与收尾背景光晕漂移一轮的时长（远慢于 5 秒一轮，MOTION-004）" }
      }
    },
    "state": {
      "$extensions": { "com.design-extract": { "scope": "inferred", "scaling": "ratio", "confidence": "inferred" } },
      "hover": { "opacity": { "$type": "number", "$value": "{primitive.opacity.hover}" } },
      "focus": {
        "opacity": { "$type": "number", "$value": "{primitive.opacity.focus}" },
        "ring": { "$type": "color", "$value": "{primitive.color.brand.caramel}" },
        "ringWidth": { "$type": "dimension", "$value": "{primitive.dimension.ring.width}", "$extensions": { "com.design-extract": { "scaling": "absolute" } } },
        "ringOffset": { "$type": "dimension", "$value": "{primitive.dimension.ring.offset}", "$extensions": { "com.design-extract": { "scaling": "absolute" } } }
      },
      "pressed": { "opacity": { "$type": "number", "$value": "{primitive.opacity.pressed}" } },
      "dragged": { "opacity": { "$type": "number", "$value": "{primitive.opacity.dragged}" } },
      "disabled": { "opacity": { "$type": "number", "$value": "{primitive.opacity.disabled}" } }
    },
    "motion": {
      "$extensions": { "com.design-extract": { "scope": "inferred", "confidence": "inferred" } },
      "duration": { "$type": "duration", "fast": { "$value": "{primitive.duration.fast}" }, "base": { "$value": "{primitive.duration.base}" }, "slow": { "$value": "{primitive.duration.slow}" } },
      "easing": { "$type": "cubicBezier", "standard": { "$value": "{primitive.easing.standard}" }, "exit": { "$value": "{primitive.easing.exit}" } },
      "reducedMotion": { "$type": "number", "$value": 0, "$extensions": { "com.design-extract": { "scaling": "ratio" } } }
    },
    "layout": {
      "$extensions": { "com.design-extract": { "scope": "inferred", "confidence": "measured" } },
      "hairline": { "$type": "dimension", "$value": "{primitive.dimension.hairline}" }
    }
  },
  "component": {}
}
