{
  "name": "shopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3360",
    "dev:worker": "tsx watch --env-file=.env src/worker/main.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3360",
    "worker": "tsx --env-file=.env src/worker/main.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/db-migrate.ts",
    "db:reset": "tsx --env-file=.env scripts/db-reset.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push --force",
    "job": "tsx --env-file=.env scripts/job.ts",
    "scenario": "tsx --env-file=.env scripts/scenario.ts",
    "inbound:replay": "tsx --env-file=.env scripts/inbound-replay.ts",
    "issues:backfill": "tsx --env-file=.env scripts/issues-backfill.ts"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@hyzyla/pdfium": "^2.1.13",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.7.7",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "yet-another-react-lightbox": "3.32.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
