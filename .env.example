# PostgreSQL 口令，compose 与 DATABASE_URL 共用 | 获取：生成（openssl rand -hex 16） | 部署层：服务器 .env.production
POSTGRES_PASSWORD=
# 数据库连接串，口令同上：本机 postgresql://shopilot:<口令>@127.0.0.1:5460/shopilot，服务器 postgresql://shopilot:<口令>@db:5432/shopilot | 获取：生成（由 POSTGRES_PASSWORD 拼成） | 部署层：服务器 .env.production
DATABASE_URL=
# Better Auth 会话签名密钥 | 获取：生成（openssl rand -hex 32） | 部署层：服务器 .env.production
BETTER_AUTH_SECRET=
# 站点根地址，用于会话 cookie、授权回调、平台推送回调（配置，非密钥） | 获取：本机固定 http://127.0.0.1:3360，服务器 https://shopilot.live | 部署层：服务器 .env.production
APP_BASE_URL=http://127.0.0.1:3360
# 平台应用密钥与店铺 token 的加密主密钥（32 字节 base64） | 获取：生成（openssl rand -base64 32） | 部署层：服务器 .env.production
APP_ENCRYPTION_KEY=
# DeepSeek 出稿、抽取、翻译 | 获取：Bitwarden 条目 DEEPSEEK_API_KEY | 部署层：服务器 .env.production
DEEPSEEK_API_KEY=
# DeepSeek 模型名（配置，非密钥） | 获取：DeepSeek 控制台模型列表；默认 deepseek-flash | 部署层：服务器 .env.production
DEEPSEEK_MODEL=deepseek-flash
# AI 调用方式：deepseek 调真实接口；stub 用模拟器里设定的替身回复（配置，非密钥） | 获取：本机测试按需切换，服务器 deepseek | 部署层：服务器 .env.production
AI_MODE=stub
# 1 = 挂载模拟平台 /mock/*、模拟器与发件箱开发页；生产必须为 0（配置，非密钥） | 获取：本机固定 1，服务器 0 | 部署层：服务器 .env.production
MOCK_PLATFORM=1
# Shopee 开放平台各区域主机，逗号分隔「区域=主机」，校验凭证时依次尝试（配置，非密钥） | 获取：本机指向模拟平台；服务器 cn=https://openplatform.shopee.cn,sg=https://partner.shopeemobile.com,br=https://openplatform.shopee.com.br（见 docs/platform-api/shopee/README.md） | 部署层：服务器 .env.production
SHOPEE_HOSTS=cn=http://127.0.0.1:3360/mock/shopee/cn,sg=http://127.0.0.1:3360/mock/shopee/sg,br=http://127.0.0.1:3360/mock/shopee/br,sandbox=http://127.0.0.1:3360/mock/shopee/sandbox
# TikTok Shop 开放接口主机（配置，非密钥） | 获取：本机指向模拟平台；服务器 https://open-api.tiktokglobalshop.com | 部署层：服务器 .env.production
TIKTOK_API_HOST=http://127.0.0.1:3360/mock/tiktok/open-api
# TikTok Shop 授权与换 token 主机（配置，非密钥） | 获取：本机指向模拟平台；服务器 https://auth.tiktok-shops.com | 部署层：服务器 .env.production
TIKTOK_AUTH_HOST=http://127.0.0.1:3360/mock/tiktok/auth
# TikTok 卖家授权页地址模板，{service_id} 换成应用的 Service ID（配置，非密钥） | 获取：本机 http://127.0.0.1:3360/mock/tiktok/auth/open/authorize；服务器 https://seller.tiktokshopglobalselling.com/services/market/custom-authorize/{service_id}（东南亚跨境店，现网 Obsbot v2 同款） | 部署层：服务器 .env.production
TIKTOK_AUTHORIZE_URL=http://127.0.0.1:3360/mock/tiktok/auth/open/authorize
# 上传图片、发票、导出包的存放目录（配置，非密钥） | 获取：本机固定 ./data，服务器 /data（挂载卷） | 部署层：服务器 .env.production
DATA_DIR=./data
# 知识库检索方式：stub 用进程内检索替身，cloudflare 调 Cloudflare AI Search（配置，非密钥） | 获取：本机与测试固定 stub，服务器 cloudflare | 部署层：服务器 .env.production
KNOWLEDGE_MODE=stub
# Cloudflare 账号 ID，AI Search 接口路径用；KNOWLEDGE_MODE=cloudflare 时必填（配置，非密钥） | 获取：Cloudflare 控制台账号首页 | 部署层：服务器 .env.production
CLOUDFLARE_ACCOUNT_ID=627a6218f132dffc9cb22dd50c2fe1a6
# Cloudflare API token，只含 AI Search 编辑与运行权限；KNOWLEDGE_MODE=cloudflare 时必填 | 获取：Bitwarden 条目 SHOPILOT_AI_SEARCH_TOKEN（不是同名条目 CLOUDFLARE_API_TOKEN） | 部署层：服务器 .env.production
CLOUDFLARE_API_TOKEN=
# 发信 SMTP 主机；SMTP_HOST、SMTP_USER、SMTP_PASS 都填了才真实发信，否则只写发件箱（配置，非密钥） | 获取：飞书企业邮箱 smtp.feishu.cn；本机留空 | 部署层：服务器 .env.production
SMTP_HOST=
# SMTP 端口，465 走 SSL，587 走 STARTTLS（配置，非密钥） | 获取：飞书企业邮箱设置页 | 部署层：服务器 .env.production
SMTP_PORT=465
# SMTP 登录账号（配置，非密钥） | 获取：飞书企业邮箱 no-reply@shopilot.live；本机留空 | 部署层：服务器 .env.production
SMTP_USER=
# SMTP 登录密码（飞书 IMAP/SMTP 专用密码） | 获取：Bitwarden 条目 SHOPILOT_SMTP_PASS | 部署层：服务器 .env.production
SMTP_PASS=
# 发件人显示（配置，非密钥） | 获取：固定 Shopilot <no-reply@shopilot.live>；本机留空 | 部署层：服务器 .env.production
SMTP_FROM=
